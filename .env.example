# The shared secret pakku presents as `Authorization: Bearer <token>`.
# Required — the service refuses to start without it. 32+ characters.
# Generate one with: openssl rand -hex 32
REALTIME_KIT_TOKEN=

# Listen address. Bind to loopback (or a private interface) — this service
# accepts LiveKit API secrets in request bodies and must not face the internet.
REALTIME_KIT_ADDR=127.0.0.1:7890

# How long one call to LiveKit may take. A user is waiting on it, so keep it low.
REALTIME_KIT_UPSTREAM_TIMEOUT=10s

# Server-side HTTP timeouts and the graceful-shutdown grace period.
REALTIME_KIT_READ_TIMEOUT=15s
REALTIME_KIT_WRITE_TIMEOUT=30s
REALTIME_KIT_SHUTDOWN_GRACE=10s

# Debug-level logging. Never logs credentials, tokens or request bodies.
REALTIME_KIT_DEBUG=false

# Local `make dev` generates and preserves these values, then supplies the pair
# to the native LiveKit server it starts on 127.0.0.1:7880. They are workspace
# provider credentials, unlike REALTIME_KIT_TOKEN above.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://127.0.0.1:7880
